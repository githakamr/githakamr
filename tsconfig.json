{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@components/layout": ["./src/exports/components/layout"],
      "@components/page": ["./src/exports/components/page"],
      "@components/provider": ["./src/exports/components/provider"],
      "@fonts/dynamic": ["./src/exports/fonts/dynamic"],
      "@fonts/static": ["./src/exports/fonts/static"],
      "@library/contexts": ["./src/exports/library/contexts"],
      "@library/hooks": ["./src/exports/library/hooks"],
      "@styles/layout": ["./src/exports/styles/layout"],
      "@styles/page": ["./src/exports/styles/page"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2017"
  },
  "exclude": ["node_modules"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
